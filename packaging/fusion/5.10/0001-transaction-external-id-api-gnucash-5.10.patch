+
+const char *
+xaccTransGetExternalId (const Transaction *trans, const char *name_space)
+{
+    if (!trans || !name_space || !*name_space) return nullptr;
+    GValue v = G_VALUE_INIT;
+    qof_instance_get_kvp (QOF_INSTANCE (trans), &v, 2,
+                          TRANS_EXTERNAL_ID_KVP, name_space);
+    const char *external_id = G_VALUE_HOLDS_STRING (&v)
+        ? g_value_get_string (&v) : nullptr;
+    g_value_unset (&v);
+    return external_id;
 }
 
