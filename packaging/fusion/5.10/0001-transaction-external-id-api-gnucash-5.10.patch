 void
+xaccTransSetExternalId (Transaction *trans, const char *name_space,
+                        const char *external_id)
+{
+    if (!trans || !name_space || !*name_space) return;
+    xaccTransBeginEdit(trans);
+    if (external_id && *external_id)
+    {
+        GValue v = G_VALUE_INIT;
+        g_value_init (&v, G_TYPE_STRING);
+        g_value_set_static_string (&v, external_id);
+        qof_instance_set_kvp (QOF_INSTANCE (trans), &v, 2,
+                              TRANS_EXTERNAL_ID_KVP, name_space);
+        g_value_unset (&v);
+    }
+    else
+    {
+        qof_instance_set_kvp (QOF_INSTANCE (trans), nullptr, 2,
+                              TRANS_EXTERNAL_ID_KVP, name_space);
+    }
+    qof_instance_set_dirty(QOF_INSTANCE(trans));
+    xaccTransCommitEdit(trans);
+}
